# ─────────────────────────────────────────────────────────────
# Memory Garden — environment configuration
# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Cloudinary credentials (Console → Settings → API Keys).
# Either set CLOUDINARY_URL, or the three separate values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Root folder for all Memory Garden assets in your Cloudinary product environment.
MG_ROOT_FOLDER=memory-garden

# Delivery type for uploaded memories. "authenticated" (recommended) means every image/video URL
# must be signed by this server, so family photos cannot be viewed or transformed by guessing URLs.
MG_DELIVERY_TYPE=authenticated

# Optional Cloudinary AI add-ons (must be registered in your Cloudinary console first).
# Suggestions are never used in games until a caregiver approves them.
MG_AI_CAPTIONING=false
# e.g. coco_v2 or lvis_v1 — leave empty to disable AI object suggestions.
MG_AI_OBJECT_DETECTION=

# Database. Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in PGLITE_DIR.
# Set it to a postgres:// connection string to use an external PostgreSQL server instead.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Demo caregiver account created by `npm run seed:demo`.
DEMO_CAREGIVER_EMAIL=demo@memorygarden.test
DEMO_CAREGIVER_PASSWORD=GardenDemo#2026
